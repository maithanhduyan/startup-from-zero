###########################
### Server Configuration
###########################
HOST=0.0.0.0
PORT=9621
WEBUI_TITLE='LightRAG Knowledge Base'
WEBUI_DESCRIPTION="Simple and Fast Graph Based RAG System"
# WORKERS=2

### Logging
# LOG_LEVEL=INFO
# VERBOSE=False

###########################
### LLM Configuration
###########################
### LLM_BINDING options: openai, ollama, azure_openai, gemini, lollms
### Nếu LightRAG chạy trong Docker và LLM service chạy trên host:
###   Sử dụng host.docker.internal thay vì localhost

LLM_BINDING=openai
LLM_MODEL=gpt-4o-mini
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=your_openai_api_key_here

### Cấu hình timeout và concurrency
# LLM_TIMEOUT=180
MAX_ASYNC=4

### === Ví dụ sử dụng Ollama ===
# LLM_BINDING=ollama
# LLM_MODEL=llama3.2:latest
# LLM_BINDING_HOST=http://host.docker.internal:11434
# OLLAMA_LLM_NUM_CTX=32768

### === Ví dụ sử dụng Azure OpenAI ===
# LLM_BINDING=azure_openai
# LLM_MODEL=your-deployment-name
# LLM_BINDING_HOST=https://your-resource.openai.azure.com/
# LLM_BINDING_API_KEY=your_azure_api_key
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

###########################
### Embedding Configuration
###########################
### EMBEDDING_BINDING options: openai, ollama, azure_openai, jina, gemini

EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=your_openai_api_key_here

### === Ví dụ sử dụng Ollama Embedding ===
# EMBEDDING_BINDING=ollama
# EMBEDDING_MODEL=nomic-embed-text:latest
# EMBEDDING_DIM=768
# EMBEDDING_BINDING_HOST=http://host.docker.internal:11434
# OLLAMA_EMBEDDING_NUM_CTX=8192

### === Ví dụ sử dụng BGE-M3 với Ollama ===
# EMBEDDING_BINDING=ollama
# EMBEDDING_MODEL=bge-m3:latest
# EMBEDDING_DIM=1024
# EMBEDDING_BINDING_HOST=http://host.docker.internal:11434

###########################
### Storage Configuration
###########################
### Mặc định sử dụng local file storage (phù hợp cho development)

LIGHTRAG_KV_STORAGE=JsonKVStorage
LIGHTRAG_VECTOR_STORAGE=NanoVectorDBStorage
LIGHTRAG_GRAPH_STORAGE=NetworkXStorage
LIGHTRAG_DOC_STATUS_STORAGE=JsonDocStatusStorage

### === Cấu hình cho Production với Neo4j + PostgreSQL ===
# LIGHTRAG_KV_STORAGE=PGKVStorage
# LIGHTRAG_VECTOR_STORAGE=PGVectorStorage
# LIGHTRAG_GRAPH_STORAGE=Neo4JStorage
# LIGHTRAG_DOC_STATUS_STORAGE=PGDocStatusStorage

### === Cấu hình PostgreSQL ===
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_USER=lightrag
# POSTGRES_PASSWORD=your_password
# POSTGRES_DATABASE=lightrag

### === Cấu hình Neo4j ===
# NEO4J_URI=neo4j://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your_password
# NEO4J_DATABASE=neo4j

### === Cấu hình Redis (cho KV và Doc Status Storage) ===
# LIGHTRAG_KV_STORAGE=RedisKVStorage
# LIGHTRAG_DOC_STATUS_STORAGE=RedisDocStatusStorage
# REDIS_URI=redis://localhost:6379

### === Cấu hình Milvus (cho Vector Storage) ===
# LIGHTRAG_VECTOR_STORAGE=MilvusVectorDBStorage
# MILVUS_URI=http://localhost:19530
# MILVUS_DB_NAME=lightrag

### === Cấu hình Qdrant (cho Vector Storage) ===
# LIGHTRAG_VECTOR_STORAGE=QdrantVectorDBStorage
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=your-api-key

###########################
### Document Processing
###########################
SUMMARY_LANGUAGE=Vietnamese
MAX_PARALLEL_INSERT=2
ENABLE_LLM_CACHE=true
ENABLE_LLM_CACHE_FOR_EXTRACT=true

### Chunk configuration
# CHUNK_SIZE=1200
# CHUNK_OVERLAP_SIZE=100

### Entity types để LLM nhận diện
# ENTITY_TYPES='["Person", "Organization", "Location", "Event", "Concept", "Method", "Content", "Data", "Artifact"]'

###########################
### Query Configuration
###########################
# TOP_K=40
# CHUNK_TOP_K=20
# MAX_ENTITY_TOKENS=6000
# MAX_RELATION_TOKENS=8000
# MAX_TOTAL_TOKENS=30000
# COSINE_THRESHOLD=0.2

###########################
### Reranking Configuration (Optional)
###########################
### RERANK_BINDING options: null, cohere, jina, aliyun
RERANK_BINDING=null

### Ví dụ sử dụng Cohere Reranker
# RERANK_BINDING=cohere
# RERANK_MODEL=rerank-v3.5
# RERANK_BINDING_HOST=https://api.cohere.com/v2/rerank
# RERANK_BINDING_API_KEY=your_cohere_api_key

### Ví dụ sử dụng Jina Reranker
# RERANK_BINDING=jina
# RERANK_MODEL=jina-reranker-v2-base-multilingual
# RERANK_BINDING_HOST=https://api.jina.ai/v1/rerank
# RERANK_BINDING_API_KEY=your_jina_api_key

###########################
### Authentication (Optional)
###########################
# AUTH_ACCOUNTS='admin:admin123,user1:pass456'
# TOKEN_SECRET=your-secret-key-for-jwt
# TOKEN_EXPIRE_HOURS=48
# LIGHTRAG_API_KEY=your-api-key-for-external-access

###########################
### Workspace Isolation
###########################
### Để tách biệt dữ liệu giữa các instance
# WORKSPACE=my_workspace
